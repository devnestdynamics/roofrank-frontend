<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1c4a35"/>
      <stop offset="100%" style="stop-color:#0f2a1f"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Logo mark — exact match to site logo, scaled up -->
  <rect x="80" y="72" width="72" height="72" rx="17" fill="#1c4a35" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
  <path d="M92 117L116 93L140 117" stroke="#7aaa8f" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="93"  y="124" width="10" height="15" rx="2.5" fill="#7aaa8f" opacity=".35"/>
  <rect x="111" y="112" width="10" height="27" rx="2.5" fill="#7aaa8f" opacity=".6"/>
  <rect x="129" y="100" width="10" height="39" rx="2.5" fill="#7aaa8f"/>

  <!-- Logo text -->
  <text x="166" y="122" font-family="Georgia, 'Times New Roman', serif" font-size="34" font-weight="500" fill="white">RoofRank</text>

  <!-- Main headline -->
  <text x="80" y="270" font-family="Georgia, 'Times New Roman', serif" font-size="62" font-weight="500" fill="white">AI-powered deal</text>
  <text x="80" y="348" font-family="Georgia, 'Times New Roman', serif" font-size="62" font-weight="500" fill="white">intelligence for</text>
  <text x="80" y="426" font-family="Georgia, 'Times New Roman', serif" font-size="62" font-weight="500" fill="#7aaa8f">multifamily investors.</text>

  <!-- Subtext -->
  <text x="80" y="506" font-family="Arial, Helvetica, sans-serif" font-size="22" fill="rgba(255,255,255,0.55)">Every deal scored · Every risk surfaced · Ranked daily</text>

  <!-- Score card -->
  <rect x="830" y="170" width="290" height="170" rx="16" fill="rgba(255,255,255,0.07)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
  <text x="975" y="242" font-family="Georgia, serif" font-size="76" font-weight="500" fill="white" text-anchor="middle">82</text>
  <text x="975" y="278" font-family="Arial, sans-serif" font-size="16" font-weight="600" letter-spacing="2" fill="#7aaa8f" text-anchor="middle">STRONG BUY</text>
  <text x="975" y="308" font-family="Arial, sans-serif" font-size="13" fill="rgba(255,255,255,0.35)" text-anchor="middle">RoofRank Score</text>

  <!-- Metric pills -->
  <rect x="830" y="360" width="88" height="30" rx="8" fill="rgba(255,255,255,0.07)"/>
  <text x="874" y="380" font-family="Arial, sans-serif" font-size="13" fill="rgba(255,255,255,0.65)" text-anchor="middle">Cap 7.3%</text>

  <rect x="928" y="360" width="88" height="30" rx="8" fill="rgba(255,255,255,0.07)"/>
  <text x="972" y="380" font-family="Arial, sans-serif" font-size="13" fill="rgba(255,255,255,0.65)" text-anchor="middle">CoC 8.1%</text>

  <rect x="1026" y="360" width="94" height="30" rx="8" fill="rgba(255,255,255,0.07)"/>
  <text x="1073" y="380" font-family="Arial, sans-serif" font-size="13" fill="rgba(255,255,255,0.65)" text-anchor="middle">DSCR 1.32</text>

  <!-- URL -->
  <text x="80" y="588" font-family="Arial, sans-serif" font-size="18" fill="rgba(255,255,255,0.3)">roofrank.io</text>
</svg>
